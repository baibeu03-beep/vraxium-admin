# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 단, 크롤러 운영자용 예시 템플릿은 커밋(실제 값 아님)
!crawler/.env.example

# claude
.claude/*
!.claude/commands/
!.claude/commands/**

# naver cafe crawl session (local only — never commit)
.naver-profile/

# codex agent logs
.codex-*.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local
screenshots-select/

# claude 작업 산출물(QA 스크린샷·감사 출력물 등 — 로컬 scratch, 필요분만 개별 강제 add)
claudedocs/
# 루트 임시 patch 파일
/*.patch
.mcp.json

# playwright MCP 브라우저 자동화 산출물(콘솔 로그·페이지 스냅샷 — 실행할 때마다 쌓인다)
.playwright-mcp/

# 데이터 백업·복구 산출물(로컬 보존 — 수십 MB 라 코드 저장소에 두지 않는다)
backups/

# scripts/ 의 "_" 접두 = 일회성 진단·검증 스크립트와 그 출력물(scratch 관례).
#   정식 검증 스크립트는 접두 없이 두고 커밋한다(verify-*.ts / browser-verify-*.mjs).
scripts/_*

# 루트 임시 감사 출력물·스크린샷(작업 중 생기는 scratch — 문서용은 docs/ 에 둔다)
/audit-result*.txt
/*.png